# SEC EDGAR User-Agent (Required by SEC: Sample Name SampleAdminContact@domain.com)
SEC_EDGAR_USER_AGENT=LSEG-GraphRAG-Research rishang19dx@users.noreply.github.com

# LLM API Configuration (OpenAI, Gemini via OpenAI-compat, Groq, Ollama, etc.)
LLM_PROVIDER=mock  # Options: openai, groq, ollama, mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Evaluation & Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Cache & Storage Settings
CACHE_DIR=./data/cache
GRAPH_STORAGE_PATH=./data/graphs/financial_kg.json
BENCHMARK_PATH=./data/benchmark/multihop_benchmark.json
